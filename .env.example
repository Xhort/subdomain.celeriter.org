# Optional. If this is omitted, local orders are stored in .data/orders.json.
DATABASE_URL=postgres://username:password@host:5432/database
DATA_DIR=.data

# Use long, random secrets here; never commit the real values to Git.
ADMIN_TOKEN=change-this-admin-password
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Required in production so Stripe returns customers to the correct trusted site.
PUBLIC_URL=http://localhost:3000

# Optional comma-separated origins if the front end is hosted on another domain.
ALLOWED_ORIGINS=

# Set both when deployed behind a trusted reverse proxy such as Render or Railway.
NODE_ENV=development
TRUST_PROXY=false
PORT=3000
